{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_BASE_URL": "https://api.apnarojgarindia.com/api/v1"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_BASE_URL": "https://api.apnarojgarindia.com/api/v1"
      },
      "android": {
        "buildType": "apk"
      }
    }
  }
}
