# Shared secrets — copy to `.env` (never commit real secrets).
# Same files on Cursor and EC2. Mode is chosen by the start script, not by editing the server.
#
#   Local (Cursor):  npm run dev   → loads .env + .env.local      → DEVELOPMENT_DB_NAME
#   Production EC2:  npm start     → loads .env + .env.production → PRODUCTION_DB_NAME
#
# Sync Cursor env → GitHub → EC2 (no SSH editing):
#   ./scripts/sync-backend-env-secrets.sh

# MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net
# DEVELOPMENT_DB_NAME=LOCAL_LABOUR_APP
# PRODUCTION_DB_NAME=LABOUR_APP
# JWT_SECRET=

# OTP / 2factor.in (required in production — no hardcoded fallback key)
# TWOFACTOR_API_KEY=
# Optional approved template name from 2factor dashboard. If unset/invalid,
# backend falls back to default AUTOGEN (no template suffix).
# TWOFACTOR_TEMPLATE_NAME=temp1

# Daily blog publish from Google Doc tabs (one tab = one blog)
# Share the Doc with GOOGLE_SERVICE_ACCOUNT_EMAIL as Editor
# Enable Docs API so tabs can be renamed to "… - Uploaded" after publish:
#   https://console.developers.google.com/apis/api/docs.googleapis.com/overview
# Put the same keys in `.env.production` for EC2 / npm start.
# GOOGLE_BLOG_IMPORT_ENABLED=true
# GOOGLE_BLOG_DOC_ID=   # document id or full docs.google.com URL
# CRON_DAILY_BLOG_PUBLISH_ENABLED=true
# Optional legacy sheet queue (only used by blog import — not weekly exports):
# GOOGLE_BLOG_SHEET_ID=

# Gmail SMTP for /auth/send-email-code (required on EC2 / production)
# Use a Google App Password (not the normal Gmail password):
#   1) Enable 2-Step Verification on the Gmail account
#   2) https://myaccount.google.com/apppasswords → create "Mail" app password
#   3) Put that 16-char password in EMAIL_PASS (no spaces)
# EMAIL_USER=your-app-gmail@gmail.com
# EMAIL_PASS=
# EMAIL_FROM="Apna Rojgar" <your-app-gmail@gmail.com>

# Notification frequency policy (all hours are Asia/Kolkata)
# Discovery notifications are skill-matched work alerts.
# NOTIFICATION_QUIET_START_HOUR_IST=21
# NOTIFICATION_QUIET_END_HOUR_IST=8
# NOTIFICATION_DISCOVERY_COOLDOWN_HOURS=12
# NOTIFICATION_DISCOVERY_DAILY_CAP=3
# NOTIFICATION_DISCOVERY_DIGEST_MINUTES=60
# NOTIFICATION_REMINDER_COOLDOWN_HOURS=48
# NOTIFICATION_EMPLOYER_APPLICATION_COOLDOWN_HOURS=24
# NOTIFICATION_PROFILE_COOLDOWN_HOURS=600
# NOTIFICATION_REMINDER_DAILY_CAP=3
# NOTIFICATION_PROMO_COOLDOWN_HOURS=168
# NOTIFICATION_PROMO_DAILY_CAP=1
# CRON_RECENT_SERVICE_WINDOW_HOURS=6
# CRON_SERVICE_NOTIFY_DEDUP_HOURS=12

# Dev-only (put in .env.local, not here):
# DEV_BYPASS_OTP=true
# SKIP_OTP=true
